# Copy to .env.local and fill in. Never commit the filled file.

# Canonical origin of the deployment. Everything SEO-facing derives from this:
# canonical URLs, hreflang alternates, sitemap.xml, OpenGraph images and JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://lueurskin.com

# Google AI (Gemini) key for the skincare advisor flow.
# Optional: without it the advisor falls back to deterministic concern matching
# rather than failing, so the feature still works — just without the model.
GOOGLE_GENAI_API_KEY=

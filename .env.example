# Copy to .env.local and fill in. Never commit the filled file.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin of the deployment. Everything SEO-facing derives from this:
# canonical URLs, hreflang alternates, sitemap.xml, OpenGraph images and JSON-LD.
# It is also the base for Stripe's success and cancel URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://lueurskin.com

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Without these the checkout runs in demo mode: a clearly-labelled order is
# recorded, no money moves, and the storefront stays walkable end to end.
#
# Secret key — server only, never prefixed with NEXT_PUBLIC_.
# Test keys start with sk_test_, live keys with sk_live_.
STRIPE_SECRET_KEY=

# Webhook signing secret for /api/webhooks/stripe. Without it the endpoint
# refuses every event rather than trusting an unverified payload, so orders
# would never be recorded and stock would never decrement.
#
# Local development:
#   stripe listen --forward-to localhost:9002/api/webhooks/stripe
#   (the CLI prints a whsec_... secret — use that one here)
#
# Production: Stripe Dashboard → Developers → Webhooks → add endpoint
#   URL:    https://<your-domain>/api/webhooks/stripe
#   Events: checkout.session.completed
#           checkout.session.async_payment_succeeded
#           checkout.session.async_payment_failed
#           checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# ── Firebase (orders, inventory, accounts) ───────────────────────────────────
# Without these the app falls back to in-memory orders and disables accounts.
# Nothing crashes, but nothing persists either.
#
# Public client config. These are NOT secrets — Firebase access is controlled by
# Security Rules and Auth, not by hiding these values.
# Firebase Console → Project settings → General → Your apps → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin credentials — server only, genuinely secret.
#
# On Firebase App Hosting and Cloud Run, Application Default Credentials are
# provided automatically: set FIREBASE_PROJECT_ID and leave the key blank.
FIREBASE_PROJECT_ID=
#
# Everywhere else, paste the whole service account JSON as ONE line.
# Firebase Console → Project settings → Service accounts → Generate new key.
# Never commit this value.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Enable Email/Password in Firebase Console → Authentication → Sign-in method,
# and add your domain under Authentication → Settings → Authorised domains.

# ── AI advisor (optional) ────────────────────────────────────────────────────
# Google AI (Gemini) key for the skincare advisor flow.
# Without it the advisor falls back to deterministic concern matching rather
# than failing, so the feature still works — just without the model.
GOOGLE_GENAI_API_KEY=

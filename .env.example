# Copy to .env.local and fill in. Never commit the filled file.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin of the deployment. Everything SEO-facing derives from this:
# canonical URLs, hreflang alternates, sitemap.xml, OpenGraph images and JSON-LD.
# It is also the base for Stripe's success and cancel URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://lueurskin.com

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Without these the checkout runs in demo mode: a clearly-labelled order is
# recorded, no money moves, and the storefront stays walkable end to end.
#
# Secret key — server only, never prefixed with NEXT_PUBLIC_.
# Test keys start with sk_test_, live keys with sk_live_.
STRIPE_SECRET_KEY=

# Webhook signing secret for /api/webhooks/stripe. Without it the endpoint
# refuses every event rather than trusting an unverified payload, so orders
# would never be recorded and stock would never decrement.
#
# Local development:
#   stripe listen --forward-to localhost:9002/api/webhooks/stripe
#   (the CLI prints a whsec_... secret — use that one here)
#
# Production: Stripe Dashboard → Developers → Webhooks → add endpoint
#   URL:    https://<your-domain>/api/webhooks/stripe
#   Events: checkout.session.completed
#           checkout.session.async_payment_succeeded
#           checkout.session.async_payment_failed
#           checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# ── Database (orders, inventory, accounts) ───────────────────────────────────
# Any Postgres: Neon, Supabase, Railway, Render, RDS, or one you host yourself.
# There is no proprietary SDK in the data layer, so switching provider is a
# change of connection string.
#
# Without this the app falls back to in-memory orders and disables accounts.
# Nothing crashes, but nothing persists either.
DATABASE_URL=

# TLS mode. Default 'require' encrypts without verifying the chain, which is
# what most managed Postgres needs. Use 'verify' when the provider's certificate
# is publicly verifiable, or 'disable' for a local database over a socket.
# DATABASE_SSL=require

# Connection pool ceiling. Keep it small on serverless, where each invocation
# opens its own connection.
# DATABASE_POOL_MAX=5

# Direct (non-pooled) endpoint, if your provider offers one. Used for
# migrations: DDL is safest on a direct connection, because a transaction-mode
# pooler can route statements of one migration to different backends.
# Neon and Supabase both expose this separately.
DATABASE_URL_UNPOOLED=

# Once the URL is set:
#   npm run db:migrate   apply the schema
#   npm run db:check     verify it end to end (writes and cleans up test rows)
#
# Connecting through a transaction pooler (Neon's `-pooler` host, or
# `pgbouncer=true`) is detected automatically and prepared statements are
# disabled — leaving them on causes intermittent failures under concurrency.

# ── AI advisor (optional) ────────────────────────────────────────────────────
# Google AI (Gemini) key for the skincare advisor flow.
# Without it the advisor falls back to deterministic concern matching rather
# than failing, so the feature still works — just without the model.
GOOGLE_GENAI_API_KEY=

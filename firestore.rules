rules_version = '2';

/**
 * Firestore Security Rules.
 *
 * Both collections here are written exclusively by the server through the Admin
 * SDK, which bypasses these rules entirely. That makes the correct client-side
 * policy "deny everything": no browser should ever read an order or edit
 * inventory directly.
 *
 * This matters more than it looks. `orders` holds names, addresses and email
 * addresses; a permissive default would expose every customer's delivery
 * details to anyone who could guess a session id. Order history reaches the
 * account page only through a server route that verifies the session cookie
 * first.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Written by the Stripe webhook, read by verified server routes only.
    match /orders/{sessionId} {
      allow read, write: if false;
    }

    // Adjusted with atomic increments by the webhook.
    match /inventory/{productId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied as well.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
